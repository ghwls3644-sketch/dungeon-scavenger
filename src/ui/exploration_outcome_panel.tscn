[node name="Summary" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
text = "입구 귀환 또는 실패 결과를 연결하면 표시됩니다."
autowrap_mode = 2

[node name="RecoveryResultPanel" parent="MarginContainer/VBoxContainer" instance=ExtResource("2_recovery")]
