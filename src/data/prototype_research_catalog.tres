[gd_resource type="Resource" script_class="ResearchCatalog" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/data/research_catalog.gd" id="1"]
[ext_resource type="Script" path="res://src/data/research_definition.gd" id="2"]

[sub_resource type="Resource" id="Record"]
script = ExtResource("2")
stable_id = &"test_g4_record_reading"
display_name = "등록 기록 열람"
required_registered_ids = Array[StringName]([&"test_g4_record"])
explanation = "등록한 시험용 원본 기록은 연구자 보관 목록에 남아 있습니다. 다음 탐험을 마친 뒤에도 이곳에서 다시 확인할 수 있습니다."

[sub_resource type="Resource" id="Combined"]
script = ExtResource("2")
stable_id = &"test_g4_combined_reading"
display_name = "두 원본 함께 열람"
required_registered_ids = Array[StringName]([&"test_g4_record", &"test_g4_artifact"])
explanation = "시험용 원본 기록과 시험용 원본 유물을 모두 등록했습니다. 두 자료는 각자의 보관 목록에 남으며, 함께 확인할 수 있는 설명이 열렸습니다."

[resource]
script = ExtResource("1")
entries = Array[ExtResource("2")]([SubResource("Record"), SubResource("Combined")])
