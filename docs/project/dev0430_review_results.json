    "script_source": "extends SceneTree\n\nconst ECONOMY = preload(\"res://src/data/prototype_economy.tres\")\nconst WEAR = preload(\"res://src/data/prototype_equipment_wear.tres\")\nconst CATALOG = preload(\"res://src/data/prototype_item_catalog.tres\")\nvar failures: Array[String] = []\nvar report: Dictionary = {}\n\nfunc _initialize() -> void:\n\tcall_deferred(\"_run\")\n\nfunc check(ok: bool, message: String) -> void:\n\tif not ok:\n\t\tfailures.append(message)\n\nfunc hub_at(money: int, durability: int) -> HubState:\n\tvar data := HubState.new().to_save_data()\n\tdata.money = str(money)\n\tdata.costs = ExpeditionCosts.new_book(money)\n\tdata.harness_durability = durability\n\treturn HubState.from_save_data(data, CATALOG)\n\nfunc outcome(kind: String) -> ExplorationOutcome:\n\tif kind == \"failure\":\n\t\treturn ExplorationOutcome.failure(1)\n\tif kind == \"normal\":\n\t\tvar items: Array[ItemDefinition] = [CATALOG.find_item(\"test_g1_light\")]\n\t\treturn ExplorationOutcome.safe_return(items)\n\treturn ExplorationOutcome.safe_return_inventory_items([], &\"emergency_escape\" if kind == \"emergency\" else &\"entrance\")\n\nfunc _run() -> void:\n\treport = {\"ticket\": \"DEV-0430\", \"checked_date_kst\": \"2026-10-15\", \"engine\": Engine.get_version_info().string,\n\t\t\"scope\": \"isolated domain comparison, no GUI/player/save mutation; proposal uses a duplicated wear resource\",\n\t\t\"boundaries\": [], \"full_repair_controls\": [], \"outcomes\": [], \"sequences\": [], \"purchase_orders\": []}\n\tfor money in [0, 4, 5, 9]:\n\t\tfor durability in [0, 1]:\n\t\t\tvar hub := hub_at(money, durability)\n\t\t\tvar before := hub.to_save_data()\n\t\t\tvar row := {\"money\": money, \"durability\": durability, \"can_depart\": hub.can_depart(ECONOMY), \"offers\": []}\n\t\t\tcheck(hub.can_depart(ECONOMY) == (durability >= 1), \"departure boundary\")\n\t\t\tvar supported := hub.quote_repair(1, ECONOMY, true)\n\t\t\tcheck((supported != null) == (durability == 0 and money < 5), \"support boundary\")\n\t\t\tfor quote in hub.get_repair_offers(ECONOMY):\n\t\t\t\tvar copy := hub.copy()\n\t\t\t\tvar applied := copy.apply_repair(quote, ECONOMY)\n\t\t\t\tcheck(applied == quote.can_afford(), \"affordability\")\n\t\t\t\tif applied:\n\t\t\t\t\tvar expected := before.duplicate(true)\n\t\t\t\t\texpected.money = str(money - quote.get_cost())\n\t\t\t\t\texpected.harness_durability = durability + quote.get_amount()\n\t\t\t\t\texpected.costs.period.repair_paid = str(quote.get_cost())\n\t\t\t\t\tcheck(copy.to_save_data() == expected, \"repair changed unrelated fields\")\n\t\t\t\t\tcheck(not copy.apply_repair(quote, ECONOMY), \"duplicate repair\")\n\t\t\t\t\tif quote.is_supported():\n\t\t\t\t\t\tcheck(copy.quote_repair(1, ECONOMY, true) == null, \"repeat support\")\n\t\t\t\telse:\n\t\t\t\t\tcheck(copy.to_save_data() == before, \"rejected repair mutated state\")\n\t\t\t\trow.offers.append({\"amount\": quote.get_amount(), \"cost\": quote.get_cost(), \"supported\": quote.is_supported(), \"affordable\": quote.can_afford(), \"applied\": applied})\n\t\t\tcheck(hub.to_save_data() == before, \"quote/candidate mutated original\")\n\t\t\treport.boundaries.append(row)\n\tfor durability in [0, 1]:\n\t\tvar hub := hub_at(15, durability)\n\t\tvar quote := hub.quote_repair(3 - durability, ECONOMY)\n\t\tcheck(hub.apply_repair(quote, ECONOMY) and hub.get_harness_durability() == 3 and hub.get_money() == 15 - (3 - durability) * 5, \"full repair control\")\n\t\treport.full_repair_controls.append({\"before_durability\": durability, \"cost\": quote.get_cost(), \"after_money\": hub.get_money(), \"after_durability\": hub.get_harness_durability()})\n\tvar proposed := WEAR.duplicate(true) as EquipmentWearRule\n\tproposed.return_damage = 0\n\tfor policy in [\"current\", \"safe_wear_zero_proposal\"]:\n\t\tvar wear: EquipmentWearRule = WEAR if policy == \"current\" else proposed\n\t\tfor durability in [0, 1, 2, 3]:\n\t\t\tfor kind in [\"normal\", \"empty\", \"emergency\", \"failure\"]:\n\t\t\t\tvar settled := SettlementResult.from_outcome(outcome(kind), ECONOMY, wear, durability)\n\t\t\t\tcheck(settled != null, \"invalid settlement\")\n\t\t\t\tvar damage: int = mini(durability, 2 if kind == \"failure\" else (1 if policy == \"current\" else 0))\n\t\t\t\tcheck(settled.get_equipment_damage().after == durability - damage, \"wear amount\")\n\t\t\t\tcheck(settled.get_full_repair_estimate() == (3 - durability + damage) * 5, \"unpaid repair estimate\")\n\t\t\t\treport.outcomes.append({\"policy\": policy, \"kind\": kind, \"before\": durability, \"damage\": damage, \"after\": settled.get_equipment_damage().after, \"repair_estimate_unpaid\": settled.get_full_repair_estimate()})\n\t\tfor spec in [\n\t\t\t{\"id\": \"safe3_minimum\", \"money\": 30, \"full\": false, \"kinds\": [\"empty\", \"empty\", \"empty\"]},\n\t\t\t{\"id\": \"safe3_full\", \"money\": 30, \"full\": true, \"kinds\": [\"empty\", \"empty\", \"empty\"]},\n\t\t\t{\"id\": \"failure3_minimum\", \"money\": 30, \"full\": false, \"kinds\": [\"failure\", \"failure\", \"failure\"]},\n\t\t\t{\"id\": \"safe_failure_safe\", \"money\": 30, \"full\": false, \"kinds\": [\"empty\", \"failure\", \"empty\"]},\n\t\t\t{\"id\": \"zero_money_safe3\", \"money\": 0, \"full\": false, \"kinds\": [\"empty\", \"empty\", \"empty\"]},\n\t\t\t{\"id\": \"zero_money_failure3\", \"money\": 0, \"full\": false, \"kinds\": [\"failure\", \"failure\", \"failure\"]}]:\n\t\t\tvar money: int = spec.money\n\t\t\tvar durability := 0\n\t\t\tvar transactions := 0\n\t\t\tvar paid := 0\n\t\t\tvar supports := 0\n\t\t\tvar events: Array = []\n\t\t\tfor kind in spec.kinds:\n\t\t\t\tvar hub := hub_at(money, durability)\n\t\t\t\tif not hub.can_depart(ECONOMY):\n\t\t\t\t\tvar quote := hub.quote_repair(1, ECONOMY, true)\n\t\t\t\t\tif quote == null:\n\t\t\t\t\t\tquote = hub.quote_repair(3 if spec.full else 1, ECONOMY)\n\t\t\t\t\tcheck(hub.apply_repair(quote, ECONOMY) and hub.can_depart(ECONOMY), \"sequence departure\")\n\t\t\t\t\ttransactions += 1\n\t\t\t\t\tpaid += quote.get_cost()\n\t\t\t\t\tsupports += int(quote.is_supported())\n\t\t\t\tvar settled := SettlementResult.from_outcome(outcome(kind), ECONOMY, wear, hub.get_harness_durability())\n\t\t\t\tmoney = hub.get_money() + settled.get_net_income()\n\t\t\t\tdurability = settled.get_equipment_damage().after\n\t\t\t\tevents.append({\"kind\": kind, \"after_money\": money, \"after_durability\": durability})\n\t\t\tvar reduced: bool = policy != \"current\" and spec.id in [\"safe3_minimum\", \"zero_money_safe3\"]\n\t\t\tvar expected_transactions := 1 if (reduced or spec.full) else (2 if policy != \"current\" and spec.id == \"safe_failure_safe\" else 3)\n\t\t\tcheck(transactions == expected_transactions, \"transaction cadence: \" + policy + \"/\" + spec.id)\n\t\t\tcheck(paid == (15 if spec.full else expected_transactions * (5 if spec.money > 0 else 0)) and money == spec.money - paid, \"sequence money\")\n\t\t\treport.sequences.append({\"policy\": policy, \"case\": spec.id, \"initial_money\": spec.money, \"initial_durability\": 0, \"income_per_run\": 0, \"repair_transactions\": transactions, \"support_transactions\": supports, \"paid\": paid, \"after_money\": money, \"after_durability\": durability, \"events\": events, \"integration_run\": false})\n\tfor order in [\"repair_first\", \"lure_first\"]:\n\t\tvar hub := hub_at(9, 0)\n\t\tif order == \"repair_first\":\n\t\t\tcheck(hub.apply_repair(hub.quote_repair(1, ECONOMY), ECONOMY), \"paid-first repair\")\n\t\t\tcheck(not hub.quote_lures(3).can_afford(), \"paid-first lure affordability\")\n\t\telse:\n\t\t\tcheck(hub.apply_lures(hub.quote_lures(3)), \"lure-first purchase\")\n\t\t\tcheck(hub.apply_repair(hub.quote_repair(1, ECONOMY, true), ECONOMY), \"lure-first support\")\n\t\tcheck(hub.get_money() == 4 and hub.can_depart(ECONOMY), \"purchase order result\")\n\t\treport.purchase_orders.append({\"order\": order, \"initial_money\": 9, \"after_money\": hub.get_money(), \"after_durability\": hub.get_harness_durability(), \"paid_lures\": hub.get_paid_lures(), \"costs\": hub.to_save_data().costs.period})\n\tcheck(WEAR.return_damage == 1 and WEAR.failure_damage == 2, \"shared resource changed\")\n\treport.passed = failures.is_empty()\n\treport.failures = failures\n\treport.scenario_count = 56\n\tvar file := FileAccess.open(\"res://.godot/dev0430-review/domain_results.json\", FileAccess.WRITE)\n\tfile.store_string(JSON.stringify(report, \"  \") + \"\\n\")\n\tfile.close()\n\tprint(\"DEV0430_COMPARE \", JSON.stringify({\"passed\": report.passed, \"failures\": failures, \"scenarios\": report.scenario_count}))\n\tquit(0 if failures.is_empty() else 1)\n",
